// Moikapy pursue-api — data-only Cloudflare Worker.
//
// Endpoints: /api/search, /api/retrieve (compat), /api/tranche-status
// No frontend. No chat. Semantic search via Vectorize + Workers AI.
// No external APIs. No secrets needed.
//
// Deploy: wrangler deploy --config wrangler.api.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pursue-api",
  "compatibility_date": "2026-05-08",
  "main": "./worker/index-api.js",
  "assets": {
    "directory": "./data-api",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "pursue-embeddings"
    }
  ],
  "routes": [
    {
      "pattern": "pursue.moikapy.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}